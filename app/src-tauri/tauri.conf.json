{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTM",
  "mainBinaryName": "ftm-app",
  "version": "0.1.0",
  "identifier": "dev.frazzer.ftm",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "cargo build -p ftmd -p ftm && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "FTM", "width": 1280, "height": 820 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
