{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTM",
  "mainBinaryName": "ftm-app",
  "identifier": "dev.frazzer.ftm",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "cargo build -p ftmd -p ftm && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Terminal workspace manager for Claude Code agents",
    "longDescription": "FTM runs Claude Code agents and shells across repos and git worktrees, with agents nested under the agent that spawned them. Ships the ftm CLI and the ftmd daemon next to the app.",
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "libayatana-appindicator3-1"],
        "conflicts": ["ftm-nightly"],
        "replaces": ["ftm-nightly"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good", "libayatana-appindicator-gtk3"],
        "conflicts": ["ftm-nightly"],
        "obsoletes": ["ftm-nightly"]
      }
    },
    "macOS": { "signingIdentity": "-" }
  }
}
